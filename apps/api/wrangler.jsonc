{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nonda-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "env": {
    "dev": {
      "name": "nonda-api-dev",
      // secrets は GitHub Actions が Doppler から wrangler secret bulk する。
      // ここに vars を置くと Doppler との二重管理になるため空にする。
    },
    "production": {
      "name": "nonda-api",
    },
  },
}
